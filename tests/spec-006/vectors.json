{
  "$comment": "Conformance vectors SPEC-006 cho src/game/grid.ts. Lưới viết bằng chuỗi: '.' đi được, '#' solid. Toạ độ [x,y]. blocked mặc định [].",
  "grids": {
    "wall-center": ["...", ".#.", "..."],
    "corridor": ["#.#", "#.#", "#.#"],
    "boxed": [".....", ".###.", ".#.#.", ".###.", "....."],
    "open4": ["....", "....", "....", "...."]
  },
  "step": [
    { "grid": "wall-center", "from": [0, 1], "dir": "right", "expect": [0, 1] },
    { "grid": "wall-center", "from": [0, 0], "dir": "up", "expect": [0, 0] },
    { "grid": "wall-center", "from": [0, 0], "dir": "left", "expect": [0, 0] },
    { "grid": "wall-center", "from": [0, 0], "dir": "right", "blocked": [[1, 0]], "expect": [0, 0] },
    { "grid": "wall-center", "from": [0, 0], "dir": "right", "expect": [1, 0] },
    { "grid": "wall-center", "from": [2, 2], "dir": "down", "expect": [2, 2] },
    { "grid": "corridor", "from": [1, 0], "dir": "down", "expect": [1, 1] }
  ],
  "findPath": [
    { "grid": "wall-center", "from": [0, 0], "to": [2, 2], "expect": [[1, 0], [2, 0], [2, 1], [2, 2]] },
    { "grid": "wall-center", "from": [0, 0], "to": [0, 0], "expect": [] },
    { "grid": "wall-center", "from": [0, 0], "to": [1, 1], "expect": null },
    { "grid": "wall-center", "from": [2, 2], "to": [0, 0], "expect": [[2, 1], [2, 0], [1, 0], [0, 0]] },
    { "grid": "corridor", "from": [1, 0], "to": [1, 2], "blocked": [[1, 1]], "expect": null },
    { "grid": "boxed", "from": [0, 0], "to": [2, 2], "expect": null },
    { "grid": "open4", "from": [0, 0], "to": [3, 3], "expect": [[1, 0], [2, 0], [3, 0], [3, 1], [3, 2], [3, 3]] },
    { "grid": "open4", "from": [3, 3], "to": [0, 0], "expect": [[3, 2], [3, 1], [3, 0], [2, 0], [1, 0], [0, 0]] },
    { "grid": "open4", "from": [0, 0], "to": [9, 9], "expect": null }
  ],
  "standSpots": [
    { "grid": "wall-center", "target": [1, 1], "expect": [[[1, 0], "down"], [[2, 1], "left"], [[1, 2], "up"], [[0, 1], "right"]] },
    { "grid": "wall-center", "target": [0, 0], "expect": [[[1, 0], "left"], [[0, 1], "up"]] },
    { "grid": "wall-center", "target": [1, 1], "blocked": [[1, 0], [0, 1]], "expect": [[[2, 1], "left"], [[1, 2], "up"]] },
    { "grid": "boxed", "target": [2, 2], "expect": [] }
  ]
}
