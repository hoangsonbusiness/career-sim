{
  "$comment": "Conformance vectors cho SPEC-002. Mọi bản implement PHẢI chạy đạt 100%. 'expect.state' so khớp từng phần: phase, segmentIndex, stats, historyLength. 'expect.result' so khớp toàn bộ các trường được liệt kê.",
  "fixture": "../fixtures/mini-profession.json",
  "vectors": [
    {
      "id": "V01-happy-path",
      "rules": ["R-3", "R-12..R-20", "R-23", "R-25"],
      "steps": [
        { "op": "state", "expect": { "state": { "phase": "intro", "segmentIndex": -1, "stats": { "a": 50, "b": 90 }, "historyLength": 0 } } },
        { "op": "start", "expect": { "state": { "phase": "segment", "segmentIndex": 0 } } },
        { "op": "submit", "answer": { "type": "sequence", "order": ["X", "Y", "Z"] }, "durationMs": 1000,
          "expect": { "result": { "segmentId": "seq", "success": true, "rawDelta": { "a": 10 }, "appliedDelta": { "a": 10 }, "feedback": [], "durationMs": 1000, "retries": 0 },
                      "state": { "phase": "feedback", "stats": { "a": 60, "b": 90 }, "historyLength": 1 } } },
        { "op": "next", "expect": { "state": { "phase": "segment", "segmentIndex": 1 } } },
        { "op": "submit", "answer": { "type": "choice", "option": 0 }, "durationMs": 0,
          "expect": { "result": { "success": null, "rawDelta": { "a": 5, "b": 20 }, "appliedDelta": { "a": 5, "b": 10 }, "feedback": ["f0"] },
                      "state": { "stats": { "a": 65, "b": 100 } } } },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "drag_sort", "placement": ["L", "R", "L"] }, "durationMs": 0,
          "expect": { "result": { "success": true, "rawDelta": { "b": 5 }, "appliedDelta": { "b": 0 }, "feedback": [] },
                      "state": { "stats": { "a": 65, "b": 100 } } } },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "spot_error", "lines": [3, 1] }, "durationMs": 0,
          "expect": { "result": { "success": true, "rawDelta": { "a": 4 }, "appliedDelta": { "a": 4 }, "feedback": ["e1", "e3"] },
                      "state": { "stats": { "a": 69, "b": 100 } } } },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "dialogue", "replies": [0, 1] }, "durationMs": 0,
          "expect": { "result": { "success": null, "rawDelta": { "a": 3, "b": 2 }, "appliedDelta": { "a": 3, "b": 0 }, "feedback": ["d00", "d11"] },
                      "state": { "stats": { "a": 72, "b": 100 } } } },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "time_budget", "minutes": [60, 30] }, "durationMs": 0,
          "expect": { "result": { "success": null, "rawDelta": { "a": 5, "b": -1 }, "appliedDelta": { "a": 5, "b": -1 }, "feedback": [] },
                      "state": { "stats": { "a": 77, "b": 99 }, "historyLength": 6 } } },
        { "op": "next", "expect": { "state": { "phase": "reflection" } } },
        { "op": "finish", "expect": { "state": { "phase": "done", "stats": { "a": 77, "b": 99 }, "historyLength": 6 } } }
      ]
    },
    {
      "id": "V02-fail-then-retry",
      "rules": ["R-12", "R-23", "R-24"],
      "steps": [
        { "op": "start" },
        { "op": "submit", "answer": { "type": "sequence", "order": ["Y", "X", "Z"] }, "durationMs": 500,
          "expect": { "result": { "success": false, "rawDelta": { "a": -10 }, "appliedDelta": { "a": -10 }, "retries": 0 }, "state": { "stats": { "a": 40, "b": 90 } } } },
        { "op": "retry", "expect": { "state": { "phase": "segment", "segmentIndex": 0, "stats": { "a": 50, "b": 90 }, "historyLength": 0 } } },
        { "op": "submit", "answer": { "type": "sequence", "order": ["X", "Y", "Z"] }, "durationMs": 300,
          "expect": { "result": { "success": true, "retries": 1, "durationMs": 300 }, "state": { "stats": { "a": 60, "b": 90 }, "historyLength": 1 } } },
        { "op": "retry" },
        { "op": "submit", "answer": { "type": "sequence", "order": ["X", "Y", "Z"] }, "durationMs": 0,
          "expect": { "result": { "retries": 2 }, "state": { "stats": { "a": 60 }, "historyLength": 1 } } },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "choice", "option": 1 }, "durationMs": 0,
          "expect": { "result": { "retries": 0 } } }
      ]
    },
    {
      "id": "V03-clamp-at-zero",
      "rules": ["R-19", "R-20"],
      "steps": [
        { "op": "start" },
        { "op": "submit", "answer": { "type": "sequence", "order": ["Z", "Y", "X"] }, "durationMs": 0 },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "choice", "option": 1 }, "durationMs": 0,
          "expect": { "result": { "rawDelta": { "a": -60 }, "appliedDelta": { "a": -40 }, "feedback": ["f1"] }, "state": { "stats": { "a": 0, "b": 90 } } } }
      ]
    },
    {
      "id": "V04-invalid-answers-leave-state-unchanged",
      "rules": ["R-4", "R-5", "R-6", "R-7", "R-8", "R-9", "R-10", "R-11", "R-17", "R-18"],
      "steps": [
        { "op": "start" },
        { "op": "submit", "answer": { "type": "choice", "option": 0 }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "sequence", "order": ["X", "Y"] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "sequence", "order": ["X", "Y", "Y"] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "sequence", "order": ["X", "Y", "Z"] }, "durationMs": -1, "expectError": "INVALID_ANSWER" },
        { "op": "state", "expect": { "state": { "phase": "segment", "segmentIndex": 0, "stats": { "a": 50, "b": 90 }, "historyLength": 0 } } },
        { "op": "submit", "answer": { "type": "sequence", "order": ["X", "Y", "Z"] }, "durationMs": 0 },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "choice", "option": 2 }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "choice", "option": -1 }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "choice", "option": 0.5 }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "choice", "option": 0 }, "durationMs": 0 },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "drag_sort", "placement": ["L", "R"] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "drag_sort", "placement": ["L", "R", "Q"] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "drag_sort", "placement": ["R", "R", "L"] }, "durationMs": 0,
          "expect": { "result": { "success": false, "rawDelta": { "b": -5 }, "appliedDelta": { "b": -5 } }, "state": { "stats": { "a": 65, "b": 95 } } } },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "spot_error", "lines": [1, 1] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "spot_error", "lines": [4] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "spot_error", "lines": [] }, "durationMs": 0,
          "expect": { "result": { "success": false, "rawDelta": { "a": -4 } }, "state": { "stats": { "a": 61, "b": 95 } } } },
        { "op": "retry" },
        { "op": "submit", "answer": { "type": "spot_error", "lines": [1, 2, 3] }, "durationMs": 0,
          "expect": { "result": { "success": false, "retries": 1 }, "state": { "stats": { "a": 61 } } } },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "dialogue", "replies": [0] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "dialogue", "replies": [0, 2] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "dialogue", "replies": [1, 0] }, "durationMs": 0,
          "expect": { "result": { "rawDelta": { "a": -3, "b": -2 }, "feedback": [] }, "state": { "stats": { "a": 58, "b": 93 } } } },
        { "op": "next" },
        { "op": "submit", "answer": { "type": "time_budget", "minutes": [60, 60] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "time_budget", "minutes": [45, 0] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "time_budget", "minutes": [30] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "submit", "answer": { "type": "time_budget", "minutes": [-30, 30] }, "durationMs": 0, "expectError": "INVALID_ANSWER" },
        { "op": "state", "expect": { "state": { "phase": "segment", "segmentIndex": 5, "stats": { "a": 58, "b": 93 }, "historyLength": 5 } } },
        { "op": "submit", "answer": { "type": "time_budget", "minutes": [0, 0] }, "durationMs": 0,
          "expect": { "result": { "rawDelta": {}, "appliedDelta": {} }, "state": { "stats": { "a": 58, "b": 93 } } } },
        { "op": "retry" },
        { "op": "submit", "answer": { "type": "time_budget", "minutes": [0, 90] }, "durationMs": 0,
          "expect": { "result": { "rawDelta": { "a": 3, "b": -3 } }, "state": { "stats": { "a": 61, "b": 90 } } } }
      ]
    },
    {
      "id": "V05-illegal-state",
      "rules": ["bảng 3.4", "R-26"],
      "steps": [
        { "op": "next", "expectError": "ILLEGAL_STATE" },
        { "op": "retry", "expectError": "ILLEGAL_STATE" },
        { "op": "finish", "expectError": "ILLEGAL_STATE" },
        { "op": "submit", "answer": { "type": "choice", "option": 99 }, "durationMs": -5, "expectError": "ILLEGAL_STATE" },
        { "op": "start" },
        { "op": "start", "expectError": "ILLEGAL_STATE" },
        { "op": "next", "expectError": "ILLEGAL_STATE" },
        { "op": "retry", "expectError": "ILLEGAL_STATE" },
        { "op": "finish", "expectError": "ILLEGAL_STATE" },
        { "op": "submit", "answer": { "type": "sequence", "order": ["X", "Y", "Z"] }, "durationMs": 0 },
        { "op": "submit", "answer": { "type": "sequence", "order": ["X", "Y", "Z"] }, "durationMs": 0, "expectError": "ILLEGAL_STATE" },
        { "op": "finish", "expectError": "ILLEGAL_STATE" },
        { "op": "state", "expect": { "state": { "phase": "feedback", "segmentIndex": 0, "stats": { "a": 60, "b": 90 }, "historyLength": 1 } } }
      ]
    }
  ]
}
