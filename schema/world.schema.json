{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World",
  "description": "Bản đồ game 2D cho một nghề (SPEC-006). Mỗi segment của nghề có một điểm việc trên bản đồ.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profession_id", "tile_size", "tilesets", "maps", "npcs", "player_sprite", "segments"],
  "properties": {
    "profession_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "tile_size": { "const": 16 },
    "tilesets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "image", "columns", "spacing"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "image": { "type": "string", "pattern": "^game/.+\\.png$" },
          "columns": { "type": "integer", "minimum": 1 },
          "spacing": { "const": 1 }
        }
      }
    },
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "width", "height", "layers", "solid", "spawn"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "layers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "data"],
              "properties": {
                "name": { "type": "string" },
                "data": { "type": "array", "items": { "anyOf": [{ "$ref": "#/$defs/tileRef" }, { "type": "null" }] } }
              }
            }
          },
          "solid": { "type": "array", "items": { "enum": [0, 1] } },
          "spawn": { "$ref": "#/$defs/pos" }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "map", "x", "y", "name", "sprite"],
        "properties": {
          "id": { "type": "string" },
          "map": { "type": "string" },
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "minLength": 1 },
          "sprite": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tileRef" } }
        }
      }
    },
    "player_sprite": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tileRef" } },
    "segments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["map", "target", "quest"],
        "properties": {
          "map": { "type": "string" },
          "target": { "$ref": "#/$defs/pos" },
          "npc": { "type": "string" },
          "quest": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "tileRef": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[0-9]+$" },
    "pos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
    }
  }
}
