{
  "name": "career-sim",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "trace": "node scripts/trace.mjs",
    "spec:lint": "node scripts/spec.mjs lint",
    "approve": "node scripts/spec.mjs approve",
    "next": "node scripts/spec.mjs next",
    "check": "npm run validate && npm run spec:lint && npm run types:check && npm run typecheck && npm test && node scripts/trace.mjs --check",
    "complete": "node scripts/spec.mjs complete",
    "scope": "node scripts/scope.mjs",
    "dev": "next dev",
    "build": "next build",
    "types": "node scripts/gen-types.mjs",
    "types:check": "node scripts/gen-types.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
